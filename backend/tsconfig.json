{
  "compilerOptions": {
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Environment */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    /* TypeScript */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /* Debugging */
    "sourceMap": true,
    /* Type Definitions */
    "types": [
      "node"
    ],
    /* Output */
    "removeComments": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}